{
	"name": "website",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm run generate && vite dev",
		"build": "vite build",
		"start": "node server/index.js",
		"test": "node --test 'server/**/*.test.js'",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm run generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"generate": "node scripts/generate-content.ts",
		"lint": "prettier --check . && eslint .",
		"knip": "pnpm run generate && svelte-kit sync && knip",
		"setup-worktree": "scripts/setup-worktree.sh",
		"verify": "node scripts/verify.ts",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@content-collections/core": "^0.15.3",
		"@content-collections/vite": "^0.3.1",
		"@eslint/js": "^10.0.1",
		"@fontsource/lexend": "^5.3.0",
		"@fontsource/spectral": "^5.3.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@lucide/svelte": "^1.75.0",
		"@maiertech/sveltekit-helpers": "^0.56.2",
		"@playwright/test": "^1.65.1",
		"@skeletonlabs/skeleton": "^5.0.5",
		"@skeletonlabs/skeleton-svelte": "^5.0.5",
		"@stackblitz/sdk": "^1.11.1",
		"@sveltejs/adapter-node": "^6.0.4",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"d3-array": "^3.2.5",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"knip": "^6.46.1",
		"mdsvex": "^0.12.8",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shiki": "^4.6.0",
		"simple-icons": "^16.38.0",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"sveltekit-embed": "^0.0.22",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"zod": "^4.6.7"
	},
	"imports": {
		"#content-collections": "./.content-collections/generated/index.js",
		"#lib/*": "./src/lib/*"
	}
}
