# Personal access token (classic) with `read:packages` permissions.
# `read:packages` is required to install package `@maiertech/sveltekit-helpers`.
#
# Required during build.
GITHUB_TOKEN=token

# Git commit SHA for the current build.
#
# Required during build.
NODION_GIT_SHA=sha

# Origin URL of the deployed site, e.g. `https://maier.tech`.
# Accessed as static variable and required during build only.
#
# Required during build.
ORIGIN=https://maier.tech

# Optional CDN origin that serves static assets, e.g. `https://cdn.maier.tech`.
# Leave empty to serve assets from `ORIGIN`.
#
# When set, the CDN hostname returns 404 for dynamic routes only. Prerendered pages and `static/`
# files are still served there, because adapter-node serves them before hooks run.
#
# Optional during build.
CDN_ORIGIN=https://cdn.maier.tech

# API key to generate OG image links.
# Required by content collections to generate OG image links.
VIRALCARDS_API_KEY=key
