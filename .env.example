# Personal access token (classic) with `read:packages` permissions.
# `read:packages` is required to install package `@maiertech/sveltekit-helpers`.
GITHUB_TOKEN=token

# Git commit SHA for the current build (available in a Nodion build).
NODION_GIT_SHA=sha

# Origin URL of the deployed site, e.g. `https://maier.tech`.
# Accessed as static variable and required during build only.
ORIGIN=origin

# API key to generate OG image links.
# Required by content collections to generate OG image links.
VIRALCARDS_API_KEY=key
