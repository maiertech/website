[
	{
		"label": "copy .env into new worktree",
		"command": "sh",
		"args": [
			"-c",
			"if [ -f \"$ZED_MAIN_GIT_WORKTREE/.env\" ]; then cp \"$ZED_MAIN_GIT_WORKTREE/.env\" \"$ZED_WORKTREE_ROOT/.env\"; fi"
		],
		"hooks": ["create_worktree"],
		"reveal": "no_focus",
		"hide": "on_success"
	},
	{
		"label": "install dependencies",
		"command": "pnpm",
		"args": ["i"],
		"cwd": "$ZED_WORKTREE_ROOT",
		"hooks": ["create_worktree"],
		"reveal": "always",
		"hide": "never"
	}
]
